# Base da API dos Correios (produção: https://api.correios.com.br)
CORREIOS_API_BASE_URL=https://api.correios.com.br
# Usuário "Meu Correios" (não é a chave de acesso)
CORREIOS_USUARIO=
# Código de acesso das APIs (gerado no portal developers.correios.com.br)
CORREIOS_CODIGO_ACESSO=

# Chave usada para assinar a sessão do login local temporário
AUTH_SECRET=

# Caminho do banco SQLite local (arquivo criado automaticamente)
DATABASE_URL=sqlite:./data/app.db
